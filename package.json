    "react-native": "0.81.5",
    "react-native-web": "~0.21.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "@types/jest": "^29.5.14",
    "typescript": "~5.9.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "prettier": "^3.5.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0"
  },
  "jest": {
    "preset": "jest-expo"
